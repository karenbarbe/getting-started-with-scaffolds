<div>
  <div>
    <h1>
      List of all movies
    </h1>

    <a href="/movies/new">New movie

    </a>

  </div>
</div>


<article>
  <ul>
    <% @list_of_movies.each do |a_movie| %>
      <li>
        <a href="/movies/<%= a_movie.id %>">
          Movie #<%= a_movie.id %>
        </a>
      </li>
    <% end %>
  </ul>
</article>
